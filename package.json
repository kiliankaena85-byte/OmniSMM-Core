{
  "name": "smmplan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && npm run build:bot && npm run build:worker && node scripts/check-bundle-secrets.mjs && tsx scripts/ci/check-api-docs-domains.ts",
    "build:lean": "powershell -ExecutionPolicy Bypass -File scripts/lean-docker-build.ps1",
    "deploy:lean": "powershell -ExecutionPolicy Bypass -File scripts/lean-docker-build.ps1 -Deploy",
    "docker:clean": "powershell -ExecutionPolicy Bypass -File scripts/docker-clean-bloat.ps1",
    "docker:up:lean": "tsx scripts/preflight-container-sizing.ts",
    "check:bundle-secrets": "node scripts/check-bundle-secrets.mjs",
    "check:domains": "tsx scripts/ci/check-api-docs-domains.ts",
    "build:bot": "esbuild src/bot/index.ts --bundle --platform=node --target=node20 --conditions=react-server --outfile=dist/bot.js --external:@prisma/client --external:@opentelemetry/api",
    "build:worker": "esbuild src/workers/index.ts --bundle --platform=node --target=node20 --conditions=react-server --outfile=dist/worker.js --external:@prisma/client --external:@opentelemetry/api",
    "start": "next start",
    "lint": "eslint .",
    "lint:debt": "npx knip",
    "typecheck": "tsc --noEmit",
    "preflight": "tsx scripts/run-production-preflight.ts",
    "verify:linux": "tsx scripts/verify-linux-build.ts",
    "catalog:ai-import": "dotenv -e .env -- tsx scripts/provider-ai-importer.ts",
    "skill:route": "tsx scripts/skill-router.ts",
    "skill:evolve": "tsx scripts/skill-evolve.ts",
    "lint:skills": "tsx scripts/audit-skills-architecture.ts",
    "lint:skills:arch": "tsx scripts/audit-skills-architecture.ts --tier=arch",
    "test:skills": "tsx scripts/audit-skills-architecture.ts --test",
    "killswitch:status": "dotenv -e .env -- tsx scripts/emergency-killswitch.ts status",
    "killswitch:on": "dotenv -e .env -- tsx scripts/emergency-killswitch.ts on",
    "killswitch:off": "dotenv -e .env -- tsx scripts/emergency-killswitch.ts off",
    "audit:deps": "tsx scripts/audit-deps.ts",
    "audit:prod": "tsx scripts/audit-production-readiness.ts",
    "audit:maker-checker": "tsx scripts/maker-checker-harness.ts",
    "audit:checker": "tsx scripts/maker-checker-ai.ts",
    "audit:maker-checker:full": "tsx scripts/maker-checker-harness.ts && tsx scripts/maker-checker-ai.ts",
    "decide": "tsx scripts/decision-engine/deterministic-arbiter.ts",
    "decide:quick": "tsx scripts/decision-engine/deterministic-arbiter.ts --quick",
    "action:decide": "tsx scripts/decision-engine/action-arbiter.ts",
    "lint:guardrails": "tsx scripts/run-ast-guardrails.ts",
    "check:arch": "tsx scripts/check-clean-architecture.ts",
    "arch:viewer": "docker compose -f docker-compose.arch.yml up -d --build",
    "arch:viewer:dev": "node tools/arch-viewer/server.mjs",
    "arch:viewer:down": "docker compose -f docker-compose.arch.yml down",
    "lint:tenant": "tsx scripts/lint-tenant-isolation.ts",
    "lint:zero-any": "tsx scripts/lint-zero-any.ts",
    "audit:jury": "tsx scripts/multi-model-jury.ts",
    "audit:swarm": "tsx scripts/harness/ai-swarm-audit.ts",
    "audit:swarm:council": "tsx scripts/harness/swarm-council-engine.ts",
    "audit:project": "tsx scripts/harness/full-project-swarm.ts",
    "audit:hexa": "tsx scripts/harness/omniaudit-hexa.ts",
    "pentest:local": "tsx scripts/security/pentest-orchestrator.ts",
    "layout:audit": "tsx scripts/ui/layout-sentry.ts",
    "layout:heal": "tsx scripts/ui/layout-healer.ts",
    "layout:fix": "tsx scripts/ui/layout-healer.ts --fix",
    "layout:mcp": "tsx scripts/ui/layout-mcp-server.ts",
    "theme:audit": "tsx scripts/ui/theme-harness.ts --audit",
    "theme:contrast": "tsx scripts/ui/theme-harness.ts --contrast",
    "theme:generate": "tsx scripts/ui/theme-harness.ts --generate",
    "mcp:pipeline": "tsx scripts/mcp/mcp-pipeline-orchestrator.ts",
    "db:backup": "powershell -Command \"docker exec smmplan_lite_db pg_dump -U postgres smmplan_lite --clean --if-exists --no-owner --no-privileges | Out-File -FilePath 'prisma/backups/smmplan_golden_backup_latest.sql' -Encoding utf8\"",
    "db:restore": "tsx scripts/restore-database.ts",
    "postinstall": "prisma generate",
    "test": "dotenv -e .env.test -- vitest run",
    "test:ci": "dotenv -e .env.test -- vitest run --coverage",
    "test:mutation": "tsx scripts/mutation-testing-redteam.ts",
    "stage:visual-audit": "tsx scripts/ephemeral-sandbox-visual-loop.ts",
    "qa:site": "tsx scripts/qa-sentinel/runner.ts",
    "qa:site:quick": "tsx scripts/qa-sentinel/runner.ts --quick",
    "heal:ooda": "tsx scripts/self-healing-ooda-loop.ts",
    "loop:self-improve": "tsx scripts/self-improving-orchestrator.ts",
    "loop:heal": "tsx scripts/self-improving-orchestrator.ts --auto-heal",
    "test:watch": "dotenv -e .env.test -- vitest",
    "test:db": "dotenv -e .env.test -- prisma db push --accept-data-loss",
    "test:db:stress": "dotenv -e .env.test -- vitest run src/__tests__/integration/db-stress-concurrency.test.ts",
    "test:db:chaos": "dotenv -e .env.test -- vitest run src/__tests__/integration/db-chaos-integrity.test.ts",
    "db:chaos:run": "tsx scripts/db-testing/db-chaos-runner.ts",
    "db:bloat": "tsx scripts/db-testing/db-bloat-diagnostics.ts",
    "db:bench:pgbench": "tsx scripts/db-testing/pgbench-runner.ts",
    "db:profile:queries": "tsx scripts/db-testing/pg-stat-statements-profiler.ts",
    "db:audit:bank": "tsx scripts/db-testing/audit-database-by-bank-skill.ts",
    "db:audit:tenants": "tsx scripts/db-testing/audit-database-tenant-isolation.ts",
    "db:test:all": "npm run test:db:stress && npm run test:db:chaos && npm run db:bloat && npm run db:profile:queries && npm run db:audit:bank && npm run db:audit:tenants",
    "test:e2e": "dotenv -v NODE_OPTIONS=\"--conditions=react-server\" -e .env.test -- playwright test",
    "test:e2e:update": "dotenv -v NODE_OPTIONS=\"--conditions=react-server\" -e .env.test -- playwright test --update-snapshots",
    "bot": "tsx src/bot/index.ts",
    "bot:bundle": "node dist/bot.js",
    "bot:dev": "dotenv -e .env -- tsx watch src/bot/index.ts",
    "worker": "tsx src/workers/index.ts",
    "audit:visual": "npx dotenv -e .env tsx scripts/synthetic-ux-lab/visual-audit-cli.ts",
    "db:seed-mock": "tsx prisma/seed-mock.ts",
    "seed:legal": "tsx scripts/seed-legal-cms.ts",
    "seed:graphrag": "dotenv -e .env -- tsx scripts/seed-graphrag-stack.ts",
    "check-balances": "dotenv -e .env -- tsx src/utils/balance-verifier.ts",
    "test:alerts": "dotenv -e .env -- tsx scripts/test-alert-system.ts",
    "pixelrag:admin": "dotenv -e .env -- tsx scripts/pixelrag-admin-audit.ts && dotenv -e .env -- tsx scripts/pixelrag-admin-analyze.ts",
    "harness:baseline": "tsx .antigravity/scripts/baseline.ts",
    "harness:validate": "tsx .antigravity/scripts/evidence-validator.ts",
    "harness:scan": "tsx .antigravity/scripts/run-scanners.ts",
    "harness:reconcile": "tsx .antigravity/scripts/reconciliation.ts",
    "harness:test": "tsx .antigravity/scripts/test-runner.ts",
    "harness:evals": "tsx .antigravity/scripts/run-evals.ts",
    "harness:selftest": "vitest run .antigravity/tests/",
    "harness:all": "npm run harness:baseline && npm run harness:scan && npm run harness:reconcile && npm run harness:test && npm run harness:evals",
    "harness:leftshift": "tsx .antigravity/scripts/leftshift/merge-gate.ts",
    "harness:leftshift:rules": "tsx .antigravity/scripts/leftshift/run-rules.ts",
    "harness:leftshift:testgate": "tsx .antigravity/scripts/leftshift/test-gate.ts",
    "harness:leftshift:invariants": "tsx .antigravity/scripts/leftshift/invariant-gate.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@blocknote/core": "^0.51.0",
    "@blocknote/mantine": "^0.51.0",
    "@blocknote/react": "^0.51.0",
    "@blocknote/server-util": "^0.51.0",
    "@heroui/react": "^3.0.3",
    "@heroui/system": "^2.4.28",
    "@heroui/theme": "^2.4.26",
    "@mantine/core": "^9.2.1",
    "@mantine/hooks": "^9.2.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@prisma/client": "^5.20.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-react": "^5.18.0",
    "bullmq": "^5.76.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "html-react-parser": "^6.1.1",
    "https-proxy-agent": "^9.1.0",
    "ioredis": "^5.10.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.447.0",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "prisma": "^5.20.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.3",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "socks-proxy-agent": "^10.1.0",
    "sonner": "^2.0.7",
    "swagger-ui-react": "^5.33.0",
    "tailwind-merge": "^3.5.0",
    "telegraf": "^4.16.3",
    "telegram": "^2.26.22",
    "undici": "^7.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.41",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^6.4.15",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "autocannon": "^8.0.0",
    "decimal.js": "^10.6.0",
    "docx": "^9.7.1",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.8.0",
    "jsdom": "^29.0.2",
    "knip": "^6.13.1",
    "node-fetch": "^2.7.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "ip-address": "^9.0.5",
    "brace-expansion": "^5.0.12"
  }
}
