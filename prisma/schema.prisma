  id          String    @id @default(cuid())
  email       String
  tenantId    String    @default("smmplan")
  ipHash      String?
  source      String    @default("holding_page")
  isNotified  Boolean   @default(false)
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([email, tenantId])
  @@index([tenantId, createdAt])
}

model TelegramSession {
  id                     String              @id // e.g. tg_79991234567
  phoneNumber            String              @unique
  sessionString          String              // GramJS StringSession (contains auth key)
  appId                  Int                 @default(2040)
  appHash                String              @default("b18441a1ff607e10a989891a5462e627")
  dcId                   Int                 @default(2) // 1..5
  deviceModel            String              @default("Samsung SM-S918B")
  systemVersion          String              @default("Android 14")
  appVersion             String              @default("10.14.0")
  proxyUrl               String?             // e.g. socks5://user:pass@host:port
  state                  String              @default("READY") // READY, WARMING, BUSY, COOLDOWN, BANNED
  hasPremium             Boolean             @default(true)
  premiumExpiresAt       DateTime?
  interactionHealthScore Int                 @default(90) // 0..100
  floodWaitUntil         DateTime?
  lastActionAt           DateTime            @default(now())
  boostSlots             TelegramBoostSlot[]
  tenantId               String              @default("smmplan")
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([state])
  @@index([interactionHealthScore])
  @@index([tenantId])
}

model TelegramBoostSlot {
  id                String          @id @default(cuid())
  sessionId         String
  session           TelegramSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  slotIndex         Int             // 0, 1, 2, 3
  assignedChannelId String?
  assignedAt        DateTime?
  expiresAt         DateTime?
  cooldownUntil     DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([sessionId, slotIndex])
  @@index([assignedChannelId])
  @@index([cooldownUntil])
}

// ─── DePIN Network Models ──────────────────────────────────────────────────────

/// Узел распределённой сети DePIN (пользователь, установивший OmniProxy/TMA).
/// Хранит накопленный баланс кредитов и статистику. Персистирует между рестартами сервера.
model DePinNode {
  id                    String    @id         // nodeId: "tg_12345678" или "node_xxxxxx"
  creditsBalance        Int       @default(0)  // Текущий баланс OmniCredits
  escrowCredits         Int       @default(0)  // Замороженные кредиты (залог за FOLLOW)
  totalCompletedTasks   Int       @default(0)  // Всего выполненных задач за всё время
  totalTapsCount        Int       @default(0)  // Физически выполненные клики-тапы в Mini App
  tasksFailed           Int       @default(0)  // Задания с фродом/отпиской
  reputation            Int       @default(100) // 0-100, влияет на награды
  lastActiveAt          DateTime  @default(now())
  lastVisitedAt         DateTime  @default(now()) // Время открытия Mini App
  lastAuditAt           DateTime? // Когда последний раз проверяли
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // ─── Task Preferences (Risk Opt-In) ───────────────────────────────────────
  // Нода сама выбирает какие типы заданий готова выполнять.
  // VIEW и REACT включены по умолчанию (opt-out). FOLLOW выключен (opt-in).
  acceptsViewTasks      Boolean   @default(true)  // 👁 Просмотры (~0% риска)
  acceptsReactTasks     Boolean   @default(true)  // 👍 Реакции (~1% риска)
  acceptsFollowTasks    Boolean   @default(false) // 👥 Подписки (~5% риска, opt-in!)

  executions            DePinTaskExecution[]

  @@index([lastActiveAt])
  @@index([reputation])
  @@index([acceptsFollowTasks]) // быстрый поиск нод готовых к подпискам
}

/// Журнал выполнения микро-задач для детальной продуктовой аналитики
model DePinTaskExecution {
  id             String    @id @default(cuid())
  nodeId         String
  taskId         String
  targetId       String?
  channel        String?
  postId         Int?
  type           String
  creditsAwarded Int       @default(0)
  createdAt      DateTime  @default(now())

  node           DePinNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([nodeId])
  @@index([type])
}

/// Коммерческая цель для распределённого просмотра.
/// Заполняется через Admin Panel при создании заказа на просмотры.
model DePinTarget {
  id             String    @id @default(cuid())
  channel        String    // e.g. "durov", "telegram"
  postId         Int
  type           String    @default("VIEW_POST") // VIEW_POST|FOLLOW_CHANNEL|REACT_POST|UNFOLLOW_CHANNEL
  status         String    @default("QUEUED")    // QUEUED|ASSIGNED|PENDING_VERIFY|COMPLETED|FAILED|CANCELLED
  targetViews    Int       // Сколько просмотров/подписок нужно набрать
  completedViews Int       @default(0)
  nodeId         String?   // Какая нода выполняет задание
  orderId        String?   // Связь с заказом клиента
  auditCount     Int       @default(0)  // Сколько раз прошёл случайный аудит
  startedAt      DateTime? // Когда нода взяла задание
  verifiedAt     DateTime? // Когда финально верифицировано
  tenantId       String    @default("smmplan")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([channel, postId])
  @@index([tenantId])
  @@index([status])
  @@index([type])
  @@index([orderId])
  @@index([completedViews, targetViews])
}

/// Эскроу замороженных кредитов за FOLLOW_CHANNEL задания.
/// 30% от награды блокируется на 72 часа как залог против отписки.
model DePinEscrow {
  id        String   @id @default(cuid())
  nodeId    String
  targetId  String   @unique
  amount    Int      // кредитов заморожено
  status    String   @default("LOCKED") // LOCKED|RELEASED|BURNED
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nodeId])
  @@index([status, expiresAt])
}

/// Лог аудитов Watchdog — история проверок подписок.
model DePinFollowAudit {
  id              String   @id @default(cuid())
  nodeId          String
  targetId        String
  telegramUserId  String
  channelId       String
  auditedAt       DateTime @default(now())
  stillMember     Boolean
  reputationDelta Int

  @@index([nodeId])
  @@index([auditedAt])
}

/// Реферальные связи DePIN TMA для вирусного роста
model DePinReferral {
  id                     String                 @id @default(cuid())
  referrerTelegramId     String                 // telegramId пригласителя
  referrerNodeId         String                 // nodeId пригласителя
  refereeTelegramId      String                 @unique // telegramId приглашенного друга
  refereeNodeId          String                 @unique // nodeId приглашенного друга
  status                 String                 @default("PENDING_QUALIFICATION") // PENDING_QUALIFICATION | QUALIFIED | BLOCKED
  welcomeBonusGranted    Boolean                @default(true)
  activationBonusGranted Boolean                @default(false)
  tapsRecorded           Int                    @default(0)
  tasksCompleted         Int                    @default(0)
  ipAddress              String?
  userAgent              String?
  qualifiedAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  earnings               DePinReferralEarning[]

  @@index([referrerTelegramId])
  @@index([referrerNodeId])
  @@index([status])
  @@index([createdAt])
}

/// Журнал начислений бонусов и 10% роялти от заданий рефералов
model DePinReferralEarning {
  id            String        @id @default(cuid())
  referralId    String
  referral      DePinReferral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  earningType   String        // 'ACTIVATION_BONUS' | 'TASK_ROYALTY'
  amountCredits Int           // Начислено в OmniCredits
  sourceTaskId  String?       // ID задания, с которого начислен процент
  createdAt     DateTime      @default(now())

  @@index([referralId])
  @@index([earningType])
  @@index([createdAt])
}

// ─── OmniOrganic Campaign Models ──────────────────────────────────────────────

/// Кампания органического роста подписчиков с управляемым churn.
/// Клиент заказывает не просто подписчиков, а органический паттерн роста.
model OrganicGrowthCampaign {
  id                  String    @id @default(cuid())
  tenantId            String    @default("smmplan")
  orderId             String    @unique           // связь с Order
  channelUsername     String                      // @target_channel (без @)
  targetNetGain       Int                         // целевой net прирост подписчиков
  durationDays        Int       @default(30)      // срок выполнения в днях
  churnRateMin        Float     @default(0.08)    // минимальный churn rate 8%
  churnRateMax        Float     @default(0.12)    // максимальный churn rate 12%
  activeHourStart     Int       @default(7)       // начало активных часов (МСК)
  activeHourEnd       Int       @default(23)      // конец активных часов (МСК)
  weekendMultiplier   Float     @default(0.6)     // множитель темпа в выходные
  status              String    @default("SCHEDULED") // SCHEDULED|ACTIVE|PAUSED|COMPLETED|CANCELLED
  followsDelivered    Int       @default(0)
  unfollowsDelivered  Int       @default(0)
  netGainActual       Int       @default(0)
  startDate           DateTime
  endDate             DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  dailyPlans          OrganicDailyPlan[]

  @@index([tenantId])
  @@index([status, startDate])
  @@index([channelUsername])
}

/// Дневной план подписок/отписок для органической кампании.
/// Генерируется при создании кампании NaturalChurnEngine.generateCampaignSchedule().
model OrganicDailyPlan {
  id               String   @id @default(cuid())
  campaignId       String
  planDate         DateTime
  targetFollows    Int
  targetUnfollows  Int
  actualFollows    Int      @default(0)
  actualUnfollows  Int      @default(0)
  completed        Boolean  @default(false)

  campaign         OrganicGrowthCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, planDate])
  @@index([planDate, completed])
  @@index([campaignId])
}
