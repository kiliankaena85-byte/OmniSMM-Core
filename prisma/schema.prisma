// AI ECONOMIC OPTIMIZATION & SENTINEL CX MODELS (Stages 2, 3, 4, 5)
// ============================================================================

enum OptimizationSnapshotStatus {
  GENERATED
  APPLIED
  PARTIALLY_APPLIED
  REJECTED
  EXPIRED
  ARCHIVED
}

enum RecommendationStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_APPLIED
}

model EconomicOptimizationSnapshot {
  id                   String                     @id @default(cuid())
  tenantId             String                     @default("smmplan")
  analyzedPeriodDays   Int                        @default(30)
  totalLeakageRub      Float                      @default(0.0)
  leakingServicesCount Int                        @default(0)
  executiveSummary     String                     @db.Text
  toolExecutionTrace   Json?                      // Full audit trace of tool calls and invariant metrics
  status               OptimizationSnapshotStatus @default(GENERATED)
  appliedBy            String?                    // User.id of operator who executed bulk apply
  appliedAt            DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  recommendations      AiPricingRecommendation[]
  appliedByUser        User?                      @relation("AppliedOptimizationSnapshots", fields: [appliedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([status])
  @@index([tenantId, status])
  @@index([appliedBy])
}

model AiPricingRecommendation {
  id                      String                       @id @default(cuid())
  snapshotId              String
  snapshot                EconomicOptimizationSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  serviceId               String
  service                 Service                      @relation("ServiceAiRecommendations", fields: [serviceId], references: [id], onDelete: Cascade)
  currentPriceRub         Float
  proposedPriceRub        Float
  currentMarkup           Float
  proposedMarkup          Float
  projectedMonthlyGainRub Float                        @default(0.0)
  confidenceScore         Float                        @default(1.0)
  status                  RecommendationStatus         @default(PENDING)
  rejectionReason         String?
  appliedAt               DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  @@index([snapshotId])
  @@index([serviceId])
  @@index([status])
  @@index([confidenceScore])
  @@index([snapshotId, status])
}

